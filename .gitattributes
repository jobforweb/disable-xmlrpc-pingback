# Normalize line endings for text files across platforms.
* text=auto eol=lf

# Explicit text types.
*.php text eol=lf
*.md  text eol=lf
*.txt text eol=lf
*.css text eol=lf
*.js  text eol=lf
*.po  text eol=lf
*.pot text eol=lf

# Binary assets must not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg binary
*.ico binary
*.zip binary
*.mo binary
